RewriteEngine On

# Consolidate the www hostname into the canonical non-www hostname.
RewriteCond %{HTTP_HOST} ^www\.hotelrestaurantelite\.ro$ [NC]
RewriteRule ^$ https://hotelrestaurantelite.ro/acasa.html [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.hotelrestaurantelite\.ro$ [NC]
RewriteRule ^ https://hotelrestaurantelite.ro%{REQUEST_URI} [R=301,L,NE]

# Keep acasa.html as the canonical Romanian homepage.
RewriteRule ^$ /acasa.html [R=301,L]
